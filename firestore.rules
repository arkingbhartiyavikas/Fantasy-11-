rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'arkingbhartiyavikas@gmail.com' ||
        request.auth.uid == 'MbvDnJk1TEbhJKu9Lj9jh0ewHyq2'
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser() {
      let data = incoming();
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() >= 0 && data.email.size() < 200 &&
             (!('numericId' in data) || data.numericId is string) &&
             (!('mobile' in data) || data.mobile is string) &&
             (!('balance' in data) || data.balance is number) &&
             (!('winnings' in data) || data.winnings is number) &&
             (!('bonus' in data) || data.bonus is number) &&
             (!('isBot' in data) || data.isBot is bool) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && isValidId(userId));
    }

    function isValidPayment() {
      let data = incoming();
      return data.userId is string && data.userId == request.auth.uid &&
             data.utr is string && data.utr.size() >= 0 && data.utr.size() <= 60 &&
             data.screenshot is string && data.screenshot.size() <= 2000000 &&
             data.planId is string && data.planId.size() > 0 && data.planId.size() <= 50 &&
             data.status is string && data.status == 'pending' &&
             data.createdAt is timestamp;
    }

    match /deposits/{docId} {
      allow create: if isSignedIn() && request.auth.uid == incoming().userId;
      allow get, list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{docId} {
      allow create: if isSignedIn() && request.auth.uid == incoming().userId;
      allow get, list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /kyc/{docId} {
      allow create: if isSignedIn() && request.auth.uid == incoming().userId;
      allow get, list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /wallets/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /bankAccounts/{docId} {
      allow create: if isSignedIn() && request.auth.uid == incoming().userId;
      allow get, list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isSignedIn() && request.auth.uid == existing().userId;
    }

    match /gameData/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /userTeams/{teamId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /payments/{paymentId} {
      allow create: if isSignedIn() && isValidPayment();
      allow get, list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    function isValidUserEdit() {
      let data = incoming();
      return data.userId is string && data.userId == request.auth.uid &&
             data.thumbnail is string && data.thumbnail.size() <= 1500000 &&
             data.timestamp == request.time &&
             data.filter is string && data.filter.size() <= 100;
    }

    match /user_edits/{editId} {
      allow create: if isSignedIn() && isValidUserEdit();
      allow get, list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_contests/{contestId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adminSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
