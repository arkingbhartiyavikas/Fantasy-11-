# Redis Configuration (For Caching/Queues)
REDIS_URL=redis://localhost:6379

# required for firebase admin (Triple-Sync)
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
